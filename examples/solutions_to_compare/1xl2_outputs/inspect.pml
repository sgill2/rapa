# Auto-generated by RAPA. Carbon colors show how each residue's state was decided:
#   red      rapa_degenerate      several states within the energy cutoff, differs between outputs
#   slate    rapa_fixed           pinned with --fix
#   grey70   rapa_metal           metal-coordinating HIS/CYS (HIM/CYM)
#   yellow   rapa_low_confidence  assigned, but the next best state is within 1 kcal/mol (or a tie)
#   magenta  rapa_flipped         side chain flipped relative to the input
#   orange   rapa_changed         protonation state changed relative to the input
#   green    rapa_unchanged       investigated, same as the input
# Labels: state, 'flip' if flipped, and energy gap to the next best state (kcal/mol).
# Each category is also a named selection in the object panel, and each residue has a scene.

load ./1xl2_outputs/1xl2_0.pdb, model_0
bg_color white
set label_size, 14
set label_color, black
set cartoon_transparency, 0.3
hide everything, all
show cartoon, all
set cartoon_color, grey80
color grey90, elem C

show lines, model_0 and chain A and resi 2 and not name N+C+O
color green, model_0 and chain A and resi 2 and elem C
show lines, model_0 and chain A and resi 7 and not name N+C+O
color green, model_0 and chain A and resi 7 and elem C
show lines, model_0 and chain A and resi 18 and not name N+C+O
color green, model_0 and chain A and resi 18 and elem C
show sticks, model_0 and chain A and resi 25 and not name N+C+O
color orange, model_0 and chain A and resi 25 and elem C
show lines, model_0 and chain A and resi 58 and not name N+C+O
color green, model_0 and chain A and resi 58 and elem C
show lines, model_0 and chain A and resi 61 and not name N+C+O
color green, model_0 and chain A and resi 61 and elem C
show sticks, model_0 and chain A and resi 69 and not name N+C+O
color yellow, model_0 and chain A and resi 69 and elem C
show lines, model_0 and chain A and resi 83 and not name N+C+O
color green, model_0 and chain A and resi 83 and elem C
show lines, model_0 and chain A and resi 88 and not name N+C+O
color green, model_0 and chain A and resi 88 and elem C
show lines, model_0 and chain A and resi 92 and not name N+C+O
color green, model_0 and chain A and resi 92 and elem C
show sticks, model_0 and chain A and resi 98 and not name N+C+O
color yellow, model_0 and chain A and resi 98 and elem C
show lines, model_0 and chain B and resi 2 and not name N+C+O
color green, model_0 and chain B and resi 2 and elem C
show lines, model_0 and chain B and resi 7 and not name N+C+O
color green, model_0 and chain B and resi 7 and elem C
show lines, model_0 and chain B and resi 18 and not name N+C+O
color green, model_0 and chain B and resi 18 and elem C
show lines, model_0 and chain B and resi 25 and not name N+C+O
color green, model_0 and chain B and resi 25 and elem C
show lines, model_0 and chain B and resi 58 and not name N+C+O
color green, model_0 and chain B and resi 58 and elem C
show lines, model_0 and chain B and resi 61 and not name N+C+O
color green, model_0 and chain B and resi 61 and elem C
show sticks, model_0 and chain B and resi 69 and not name N+C+O
color yellow, model_0 and chain B and resi 69 and elem C
show lines, model_0 and chain B and resi 83 and not name N+C+O
color green, model_0 and chain B and resi 83 and elem C
show lines, model_0 and chain B and resi 88 and not name N+C+O
color green, model_0 and chain B and resi 88 and elem C
show lines, model_0 and chain B and resi 92 and not name N+C+O
color green, model_0 and chain B and resi 92 and elem C
show lines, model_0 and chain B and resi 98 and not name N+C+O
color green, model_0 and chain B and resi 98 and elem C
label model_0 and chain A and resi 25 and name CA, "ASH +2.2"
label model_0 and chain A and resi 69 and name CA, "HIE +0.0"
label model_0 and chain A and resi 98 and name CA, "ASN +0.0"
label model_0 and chain B and resi 69 and name CA, "HIE flip +0.0"
hide sticks, elem H

select rapa_low_confidence, (model_0 and chain A and resi 69) or (model_0 and chain A and resi 98) or (model_0 and chain B and resi 69)
select rapa_changed, (model_0 and chain A and resi 25)
select rapa_unchanged, (model_0 and chain A and resi 2) or (model_0 and chain A and resi 7) or (model_0 and chain A and resi 18) or (model_0 and chain A and resi 58) or (model_0 and chain A and resi 61) or (model_0 and chain A and resi 83) or (model_0 and chain A and resi 88) or (model_0 and chain A and resi 92) or (model_0 and chain B and resi 2) or (model_0 and chain B and resi 7) or (model_0 and chain B and resi 18) or (model_0 and chain B and resi 25) or (model_0 and chain B and resi 58) or (model_0 and chain B and resi 61) or (model_0 and chain B and resi 83) or (model_0 and chain B and resi 88) or (model_0 and chain B and resi 92) or (model_0 and chain B and resi 98)
deselect

orient chain A and resi 25
zoom chain A and resi 25, 6
show lines, byres ((chain A and resi 25) around 4) and not elem H
scene A_25_ASH, store
hide lines
orient chain A and resi 69
zoom chain A and resi 69, 6
show lines, byres ((chain A and resi 69) around 4) and not elem H
scene A_69_HIE, store
hide lines
orient chain A and resi 98
zoom chain A and resi 98, 6
show lines, byres ((chain A and resi 98) around 4) and not elem H
scene A_98_ASN, store
hide lines
orient chain B and resi 69
zoom chain B and resi 69, 6
show lines, byres ((chain B and resi 69) around 4) and not elem H
scene B_69_HIE, store
hide lines
zoom all
# End of script
