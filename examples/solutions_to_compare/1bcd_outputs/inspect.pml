label model_0 and chain A and resi 178 and name CA, "ASN flip +1.2"
label model_0 and chain A and resi 253 and name CA, "ASN flip +3.8"
hide sticks, elem H

select rapa_degenerate, (model_0 and chain A and resi 122) or (model_1 and chain A and resi 122)
select rapa_metal, (model_0 and chain A and resi 94) or (model_0 and chain A and resi 96) or (model_0 and chain A and resi 119) or (model_1 and chain A and resi 94) or (model_1 and chain A and resi 96) or (model_1 and chain A and resi 119)
