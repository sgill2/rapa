select rapa_changed, (model_0 and chain A and resi 3) or (model_0 and chain A and resi 10) or (model_0 and chain A and resi 15) or (model_0 and chain A and resi 107) or (model_1 and chain A and resi 3) or (model_1 and chain A and resi 10) or (model_1 and chain A and resi 15) or (model_1 and chain A and resi 107)
